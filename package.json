{
  "name": "linksunder",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "Local, assertion-driven network resilience testing with Playwright",
  "license": "MIT",
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "schema:export": "tsx scripts/export-schema.mjs",
    "dev": "tsx server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "desktop:dev": "npm run build && electron .",
    "desktop:browser": "node scripts/bundle-browser.mjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:update-integration": "node scripts/test-update-integration.mjs",
    "benchmark:history": "tsx scripts/benchmark-history.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@fontsource/inter": "^5.3.0",
    "builder-util-runtime": "^9.7.0",
    "electron-updater": "^6.8.11",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "maxmind": "^5.1.0",
    "playwright": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  },
  "main": "desktop/main.cjs",
  "author": "LinkSunder contributors"
}
